// marble.syb.lol on Cloudflare Workers: site/ as static files (any other path gets index.html, as GitHub Pages' 404.html
// did), and worker/index.js first for shared links to posts and people (and Android's assetlinks.json).
//   npx wrangler dev                      (http://localhost:8788; --var RELAYS:ws://localhost:10547 for a local relay)
//   npx wrangler deploy                   (held: see the deploy notes)
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "marble-syb-lol",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "site",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/note1*", "/nevent1*", "/npub1*", "/nprofile1*", "/naddr1*", "/e/*", "/p/*", "/a/*", "/.well-known/assetlinks.json"]
  },
  "vars": {
    // the Android app's signing certificates for App Links, "AA:BB:…" comma-separated: the release APK is signed with
    // key rotation, so both its original signer and the current release key (the same pair cosign.aaro.cc serves)
    "ANDROID_CERTS": "45:87:63:71:86:3E:72:1D:35:74:D2:D5:90:92:B8:08:FF:A8:03:55:83:DB:3D:64:23:25:E8:5E:51:7C:CC:EE,72:5C:CE:7F:39:24:DB:8F:2E:AD:6E:42:7A:BC:2C:86:B5:D8:D8:54:66:96:33:BD:32:4B:EE:6D:64:90:8B:DE"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
  // "routes": [{ "pattern": "marble.syb.lol", "custom_domain": true }]   (held for the user's go: see the deploy notes)
}

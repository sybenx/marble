<resources>
    <style name="Theme.Cosign" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ground</item>
        <item name="android:windowSplashScreenBackground">@color/ground</item>
        <!-- A plain splash: the ground, light or dark, and no icon (Android always draws one, so a see-through one).
             MainActivity keeps it up until the first screen is the right one. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- The Android signer's sheet opens over the app that asked. -->
    <style name="Theme.Cosign.Sheet" parent="Theme.Cosign">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Translucent</item>
    </style>
</resources>

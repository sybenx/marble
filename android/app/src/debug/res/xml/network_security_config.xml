<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds: the release config, plus a relay or a Keykin box on this Mac for tests on the emulator
     (10.0.2.2), and the Keykin box on the tailnet, which speaks plain http there (100.101.35.120). A release
     build reaches a box over https only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <!-- The emulator's own loopback, forwarded to this Mac with `adb reverse`: QRST takes a ws:// relay only there. -->
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">100.101.35.120</domain>
    </domain-config>
</network-security-config>

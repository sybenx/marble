{
 "about": "The shared list-write rule (list-writes.md): changing one entry of your follows (3), bookmarks (10003), Special Follow (10010), favourite relays (10012), DM inbox (10050), sets (30000/30002) or app data (30078). Each case: what was found (this device's and the relays' versions, any author or kind: the rule picks), the change, and what must happen: write (the new tags, content and created_at), nothing, or refuse. Pubkeys are short stand-ins; ME is you.",
 "me": "ME",
 "now": 1000,
 "writes": [
  { "name": "follow: the newest of three versions is the start; the others are ignored",
    "found": [
     { "id": "a1", "pubkey": "ME", "kind": 3, "created_at": 500, "content": "", "tags": [["p", "P1"]] },
     { "id": "a2", "pubkey": "ME", "kind": 3, "created_at": 900, "content": "{\"wss://r.example\":{\"read\":true}}", "tags": [["p", "P1"], ["p", "P2", "wss://x.example", "jo"], ["t", "nostr"]] },
     { "id": "a3", "pubkey": "ME", "kind": 3, "created_at": 700, "content": "", "tags": [["p", "P1"], ["p", "P2"], ["p", "P3"]] }],
    "kind": 3, "change": { "add": ["p", "P9"] }, "expected": true,
    "write": { "tags": [["p", "P1"], ["p", "P2", "wss://x.example", "jo"], ["t", "nostr"], ["p", "P9"]], "content": "{\"wss://r.example\":{\"read\":true}}", "created_at": 1000 } },
  { "name": "someone else's list and another kind are never the start",
    "found": [
     { "id": "b1", "pubkey": "OTHER", "kind": 3, "created_at": 990, "content": "", "tags": [["p", "X"]] },
     { "id": "b2", "pubkey": "ME", "kind": 10000, "created_at": 995, "content": "", "tags": [["p", "MUTED"]] },
     { "id": "b3", "pubkey": "ME", "kind": 3, "created_at": 100, "content": "", "tags": [["p", "P1"]] }],
    "kind": 3, "change": { "add": ["p", "P2"] }, "expected": true,
    "write": { "tags": [["p", "P1"], ["p", "P2"]], "content": "", "created_at": 1000 } },
  { "name": "unfollow: only that person goes; everything else stays in order",
    "found": [{ "id": "c1", "pubkey": "ME", "kind": 3, "created_at": 800, "content": "x", "tags": [["p", "P1"], ["p", "P2"], ["unknown", "keep", "me"], ["p", "P3"]] }],
    "kind": 3, "change": { "remove": ["p", "P2"] }, "expected": true,
    "write": { "tags": [["p", "P1"], ["unknown", "keep", "me"], ["p", "P3"]], "content": "x", "created_at": 1000 } },
  { "name": "unfollow someone listed twice: both copies go (one entry)",
    "found": [{ "id": "d1", "pubkey": "ME", "kind": 3, "created_at": 800, "content": "", "tags": [["p", "P1"], ["p", "P2"], ["p", "P2", "wss://x.example"]] }],
    "kind": 3, "change": { "remove": ["p", "P2"] }, "expected": true,
    "write": { "tags": [["p", "P1"]], "content": "", "created_at": 1000 } },
  { "name": "a clock behind the list: created_at is the old one + 1",
    "found": [{ "id": "e1", "pubkey": "ME", "kind": 10010, "created_at": 5000, "content": "ENCRYPTED", "tags": [["p", "P1"]] }],
    "kind": 10010, "change": { "add": ["p", "P2"] }, "expected": true,
    "write": { "tags": [["p", "P1"], ["p", "P2"]], "content": "ENCRYPTED", "created_at": 5001 } },
  { "name": "the same moment: the lowest id is the newest (NIP-01)",
    "found": [
     { "id": "ff", "pubkey": "ME", "kind": 10012, "created_at": 900, "content": "", "tags": [["relay", "wss://b.example"]] },
     { "id": "0a", "pubkey": "ME", "kind": 10012, "created_at": 900, "content": "", "tags": [["relay", "wss://a.example"]] }],
    "kind": 10012, "change": { "add": ["relay", "wss://c.example"] }, "expected": true,
    "write": { "tags": [["relay", "wss://a.example"], ["relay", "wss://c.example"]], "content": "", "created_at": 1000 } },
  { "name": "a relay written differently is the same relay",
    "found": [{ "id": "g1", "pubkey": "ME", "kind": 10012, "created_at": 900, "content": "", "tags": [["relay", "wss://Relay.Example.com/"], ["relay", "wss://b.example"]] }],
    "kind": 10012, "change": { "remove": ["relay", "wss://relay.example.com"] }, "expected": true,
    "write": { "tags": [["relay", "wss://b.example"]], "content": "", "created_at": 1000 } },
  { "name": "a set: only the one with that d; its title and d stay",
    "found": [
     { "id": "h1", "pubkey": "ME", "kind": 30002, "created_at": 950, "content": "", "tags": [["d", "other"], ["relay", "wss://z.example"]] },
     { "id": "h2", "pubkey": "ME", "kind": 30002, "created_at": 900, "content": "", "tags": [["d", "news"], ["title", "News"], ["relay", "wss://a.example"]] }],
    "kind": 30002, "d": "news", "change": { "add": ["relay", "wss://n.example"] }, "expected": true,
    "write": { "tags": [["d", "news"], ["title", "News"], ["relay", "wss://a.example"], ["relay", "wss://n.example"]], "content": "", "created_at": 1000 } },
  { "name": "a new set: just its d and the entry",
    "found": [], "kind": 30002, "d": "new", "change": { "add": ["relay", "wss://a.example"] }, "expected": false,
    "write": { "tags": [["d", "new"], ["relay", "wss://a.example"]], "content": "", "created_at": 1000 } },
  { "name": "a new set with a title: d, then its title, then the entry",
    "found": [], "kind": 30002, "d": "new", "title": "Reading", "change": { "add": ["relay", "wss://a.example"] }, "expected": false,
    "write": { "tags": [["d", "new"], ["title", "Reading"], ["relay", "wss://a.example"]], "content": "", "created_at": 1000 } },
  { "name": "a first list, when none is expected: just the entry",
    "found": [], "kind": 10003, "change": { "add": ["e", "E1"] }, "expected": false,
    "write": { "tags": [["e", "E1"]], "content": "", "created_at": 1000 } }
 ],
 "nothing": [
  { "name": "follow someone already followed",
    "found": [{ "id": "i1", "pubkey": "ME", "kind": 3, "created_at": 800, "content": "", "tags": [["p", "P1"]] }],
    "kind": 3, "change": { "add": ["p", "P1"] }, "expected": true },
  { "name": "unfollow someone not followed",
    "found": [{ "id": "j1", "pubkey": "ME", "kind": 3, "created_at": 800, "content": "", "tags": [["p", "P1"]] }],
    "kind": 3, "change": { "remove": ["p", "P2"] }, "expected": true },
  { "name": "take out of a list that isn't there",
    "found": [], "kind": 10010, "change": { "remove": ["p", "P1"] }, "expected": false }
 ],
 "refuse": [
  { "name": "follow when no follow list was found but one is expected (never a near-empty list)",
    "found": [{ "id": "k1", "pubkey": "OTHER", "kind": 3, "created_at": 800, "content": "", "tags": [["p", "P1"]] }],
    "kind": 3, "change": { "add": ["p", "P9"] }, "expected": true, "why": "no list found" },
  { "name": "unfollow when no list was found but one is expected",
    "found": [], "kind": 3, "change": { "remove": ["p", "P1"] }, "expected": true, "why": "no list found" }
 ],
 "guard": [
  { "name": "a change of one entry passes",
    "old": { "kind": 3, "created_at": 900, "content": "c", "tags": [["p", "P1"], ["p", "P2"]] },
    "next": { "kind": 3, "created_at": 1000, "content": "c", "tags": [["p", "P1"]] }, "why": null },
  { "name": "two people gone",
    "old": { "kind": 3, "created_at": 900, "content": "", "tags": [["p", "P1"], ["p", "P2"], ["p", "P3"]] },
    "next": { "kind": 3, "created_at": 1000, "content": "", "tags": [["p", "P1"]] }, "why": "takes out more than one" },
  { "name": "a near-empty list over a full one",
    "old": { "kind": 3, "created_at": 900, "content": "", "tags": [["p", "P1"], ["p", "P2"], ["p", "P3"], ["p", "P4"]] },
    "next": { "kind": 3, "created_at": 1000, "content": "", "tags": [["p", "P9"]] }, "why": "takes out more than one" },
  { "name": "the private part dropped",
    "old": { "kind": 10010, "created_at": 900, "content": "ENCRYPTED", "tags": [["p", "P1"]] },
    "next": { "kind": 10010, "created_at": 1000, "content": "", "tags": [["p", "P1"], ["p", "P2"]] }, "why": "the private part changed" },
  { "name": "an unknown tag dropped",
    "old": { "kind": 3, "created_at": 900, "content": "", "tags": [["p", "P1"], ["unknown", "x"]] },
    "next": { "kind": 3, "created_at": 1000, "content": "", "tags": [["p", "P1"], ["p", "P2"], ["unknown", "y"]] }, "why": "changes more than the one entry" },
  { "name": "a set's title changed",
    "old": { "kind": 30002, "created_at": 900, "content": "", "tags": [["d", "news"], ["title", "News"]] },
    "next": { "kind": 30002, "created_at": 1000, "content": "", "tags": [["d", "news"], ["title", "Old"], ["relay", "wss://a.example"]] }, "why": "changes more than the one entry" },
  { "name": "nothing changed at all",
    "old": { "kind": 3, "created_at": 900, "content": "", "tags": [["p", "P1"]] },
    "next": { "kind": 3, "created_at": 1000, "content": "", "tags": [["p", "P1"]] }, "why": "changes more than the one entry" },
  { "name": "the order of the others changed",
    "old": { "kind": 3, "created_at": 900, "content": "", "tags": [["p", "P1"], ["p", "P2"]] },
    "next": { "kind": 3, "created_at": 1000, "content": "", "tags": [["p", "P2"], ["p", "P1"], ["p", "P3"]] }, "why": "other tags changed" },
  { "name": "not newer than the old one",
    "old": { "kind": 3, "created_at": 900, "content": "", "tags": [["p", "P1"]] },
    "next": { "kind": 3, "created_at": 900, "content": "", "tags": [["p", "P1"], ["p", "P2"]] }, "why": "not newer" },
  { "name": "another set's d",
    "old": { "kind": 30002, "created_at": 900, "content": "", "tags": [["d", "news"]] },
    "next": { "kind": 30002, "created_at": 1000, "content": "", "tags": [["d", "other"]] }, "why": "a different list" }
 ]
}
